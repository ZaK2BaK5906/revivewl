# JWT Configuration
JWT_SECRET=change-this-to-a-very-secure-random-string
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=3000
NODE_ENV=development

# CORS
FRONTEND_URL=http://localhost:5173

# Discord Webhooks
DISCORD_WEBHOOK_INTERVIEWS=
DISCORD_WEBHOOK_VALIDATIONS=
