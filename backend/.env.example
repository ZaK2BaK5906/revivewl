# CORS
CORS_ORIGIN=http://localhost:5173

# Session
SESSION_SECRET=CHANGEZ_CETTE_CLE_SESSION_SECRETE_987654321

# API externe (optionnel)
API_KEY_ENABLED=false
API_RATE_LIMIT=100

# Master Admin (premier compte à créer)
MASTER_ADMIN_USERNAME=master
