# Serveur
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Base de données MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=zak
DB_PASSWORD=Floflo1101*
DB_NAME=fivem_whitelist

# JWT & Sécurité
JWT_SECRET=CHANGEZ_CETTE_CLE_SECRETE_TRES_LONGUE_ET_ALEATOIRE_123456789
JWT_REFRESH_SECRET=CHANGEZ_CETTE_CLE_REFRESH_AUSSI_TRES_LONGUE_987654321
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5

# Webhooks Discord
DISCORD_WEBHOOK_WL_VALIDEE=https://discord.com/api/webhooks/VOTRE_WEBHOOK_ID/TOKEN
DISCORD_WEBHOOK_WL_REFUSEE=https://discord.com/api/webhooks/VOTRE_WEBHOOK_ID/TOKEN
DISCORD_WEBHOOK_WL_ATTENTE=https://discord.com/api/webhooks/VOTRE_WEBHOOK_ID/TOKEN
DISCORD_WEBHOOK_ENTRETIEN=https://discord.com/api/webhooks/VOTRE_WEBHOOK_ID/TOKEN
DISCORD_WEBHOOK_ADMIN=https://discord.com/api/webhooks/VOTRE_WEBHOOK_ID/TOKEN
DISCORD_WEBHOOK_SECURITY=https://discord.com/api/webhooks/VOTRE_WEBHOOK_ID/TOKEN
DISCORD_WEBHOOK_BACKUP=https://discord.com/api/webhooks/VOTRE_WEBHOOK_ID/TOKEN
DISCORD_WEBHOOK_DAILY_REPORT=https://discord.com/api/webhooks/VOTRE_WEBHOOK_ID/TOKEN
