DISCORD_CLIENT_ID=

# Upload fichiers
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Backup
BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_CRON_SCHEDULE=0 4 * * *

# Logs
LOG_LEVEL=info
LOG_PATH=./logs

# 2FA
TWO_FA_ISSUER=FiveM Whitelist Panel
